#!/bin/sh
set -eu

APP_NAME="sample-cli"
APP_DIR="/opt/${APP_NAME}"
BIN_DIR="/usr/local/bin"
LAUNCHER="${APP_DIR}/bin/${APP_NAME}"
LINK="${BIN_DIR}/${APP_NAME}"
UNINSTALL="${BIN_DIR}/${APP_NAME}-uninstall"
CACHE_ROOT="/tmp/gdal4k-cache"

mkdir -p "${BIN_DIR}"
ln -sfn "${LAUNCHER}" "${LINK}"

cat > "${UNINSTALL}" <<EOF
#!/bin/sh
set -eu

APP_NAME="${APP_NAME}"
APP_DIR="${APP_DIR}"
LINK="${LINK}"
UNINSTALL="${UNINSTALL}"
CACHE_ROOT="${CACHE_ROOT}"

if [ "\$(id -u)" -ne 0 ]; then
  echo "Run this command with sudo: sudo \${APP_NAME}-uninstall" >&2
  exit 1
fi

rm -f "\${LINK}"
rm -f "\${UNINSTALL}"
rm -rf "\${APP_DIR}"
rm -rf "\${CACHE_ROOT}"
EOF

chmod 755 "${UNINSTALL}"
