#!/bin/sh
set -eu

APP_NAME="sample-cli"
APP_DIR="/opt/${APP_NAME}"
BIN_DIR="/usr/local/bin"
LINK="${BIN_DIR}/${APP_NAME}"
UNINSTALL="${BIN_DIR}/${APP_NAME}-uninstall"
CACHE_ROOT="/tmp/gdal4k-cache"

case "${1:-}" in
  remove|purge|upgrade|deconfigure|"")
    rm -f "${LINK}"
    rm -f "${UNINSTALL}"
    rm -rf "${APP_DIR}"
    rm -rf "${CACHE_ROOT}"
    ;;
esac
